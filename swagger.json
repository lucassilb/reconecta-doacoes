  "info": {
    "title": "ReConecta API",
    "version": "1.0",
    "description": "API REST da plataforma ReConecta para redistribuição de excedentes alimentares"
  },
  "produces": [
    "application/json"
  ],
  "consumes": [
    "application/json"
  ],
  "securityDefinitions": {
    "AdminToken": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Admin-Token"
    }
  },
  "tags": [
    {
      "name": "estabelecimentos",
      "description": "Operações relacionadas aos estabelecimentos doadores"
    },
    {
      "name": "instituicoes",
      "description": "Operações relacionadas às instituições receptoras"
    },
    {
      "name": "doacoes",
      "description": "Operações relacionadas às doações de alimentos"
    },
    {
      "name": "cadastro",
      "description": "Verificação de CNPJ e cadastro de doadores"
    },
    {
      "name": "auth",
      "description": "Entrada, saída e sessão do usuário"
    },
    {
      "name": "publico",
      "description": "Resumo e pedidos disponíveis"
    },
    {
      "name": "painel",
      "description": "Pedidos e doações do usuário"
    },
    {
      "name": "contribuicoes",
      "description": "Fotos privadas das doações recebidas"
    },
    {
      "name": "dashboard",
      "description": "Indicadores públicos agregados"
    },
    {
      "name": "ia",
      "description": "Sugestões com modelo local e regras de fallback"
    }
  ],
  "definitions": {
    "Estabelecimento": {
      "required": [
        "cnpj",
        "email",
        "endereco",
        "nome"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "ID do estabelecimento",
          "readOnly": true
        },
        "nome": {
          "type": "string",
          "description": "Nome do estabelecimento"
        },
        "cnpj": {
          "type": "string",
          "description": "CNPJ do estabelecimento"
        },
        "email": {
          "type": "string",
          "description": "Email do estabelecimento"
        },
        "telefone": {
          "type": "string",
          "description": "Telefone do estabelecimento"
        },
        "endereco": {
          "type": "string",
          "description": "Endereço do estabelecimento"
        }
      },
      "type": "object"
    },
    "Instituicao": {
      "required": [
        "cnpj",
        "email",
        "endereco",
        "nome"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "ID da instituição",
          "readOnly": true
        },
        "nome": {
          "type": "string",
          "description": "Nome da instituição"
        },
        "cnpj": {
          "type": "string",
          "description": "CNPJ da instituição"
        },
        "email": {
          "type": "string",
          "description": "Email da instituição"
        },
        "telefone": {
          "type": "string",
          "description": "Telefone da instituição"
        },
        "endereco": {
          "type": "string",
          "description": "Endereço da instituição"
