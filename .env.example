# Sem DATABASE_URL, a aplicação cria reconecta.db em SQLite.
# Para PostgreSQL local, defina DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/reconecta_dev
# Na nuvem, use a URL de sessao do pooler Supabase (SSL obrigatorio e automatico).
FLASK_APP=app.py
FLASK_DEBUG=0
# FLASK_RUN_HOST=127.0.0.1  # servidor de desenvolvimento; gunicorn usa 0.0.0.0 no Docker
# SECRET_KEY=defina_uma_chave_longa_e_aleatoria_em_producao
# COOKIE_SEGURO=1  # Render/HTTPS; deixe ausente em HTTP local
# PORT=5000
# Escrita dos CRUDs legados desativada se ADMIN_TOKEN não estiver configurado.
# ADMIN_TOKEN=defina_um_token_longo_e_aleatorio
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:3b
# Opcional: chave do Groq Free, configurada só no ambiente (nunca no Git).
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Apenas Docker Compose local: troque estes valores antes de compartilhar um ambiente.
# POSTGRES_PASSWORD=dev-only-change-me
# COMPOSE_OLLAMA_URL=http://ollama:11434
